server {
   server_name 89.169.175.171 taski777.hopto.org;

   location /api/ {
      proxy_pass http://127.0.0.1:8000;
   }

   location /admin/ {
      proxy_pass http://127.0.0.1:8000;
    }

   location / {
      root /var/www/taski;
      index index.html index.htm;
      try_files $uri /index.html;
   }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/taski777.hopto.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/taski777.hopto.org/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = taski777.hopto.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


   listen 80;
   server_name 89.169.175.171 taski777.hopto.org;
    return 404; # managed by Certbot


}
server {
   server_name kittygram777.ru;
   
   location /api/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;  # Важно для HTTPS!
    client_max_body_size 5M;
}

   location /admin/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;  # Важно для HTTPS!
    client_max_body_size 5M;
}   location / {
      root /var/www/kittygram;
      index index.html index.htm;
      try_files $uri /index.html;
   }
   location /media/ {
      alias /var/www/kittygram/media/;
   }
   

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/kittygram777.ru/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/kittygram777.ru/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

